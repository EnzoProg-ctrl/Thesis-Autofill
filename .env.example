# Your own Supabase project, for docker compose.
#
# Without a .env file, docker compose uses the public demo database. To use
# your own copy instead, copy this file to .env (same folder as
# docker-compose.yml) and replace both values with the ones from your project:
#   Supabase dashboard > Project Settings > API
#
# Use the "anon public" key. Never the service_role key: anything here ends up
# in the browser.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
